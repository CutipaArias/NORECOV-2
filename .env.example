# Ejecuta: python scripts/generate_env.py  (crea .env con secretos aleatorios)
CONTROL_MONGO_USER=norecov_admin
CONTROL_MONGO_PASSWORD=CAMBIAR
CONTROL_MONGO_URI=mongodb://norecov_admin:CAMBIAR@mongo-control:27017/admin?authSource=admin
CONTROL_DB=norecov
SECRET_KEY=CAMBIAR
ENCRYPTION_KEY=CAMBIAR_BASE64_32_BYTES
ADMIN_EMAIL=admin@norecov.local
ADMIN_PASSWORD=CAMBIAR
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ARTIFACT_DIR=/data/artifacts
# Datos de ejemplo
DEMO_MONGO_USER=root
DEMO_MONGO_PASSWORD=CAMBIAR
DEMO_REDIS_PASSWORD=CAMBIAR
# S3/MinIO opcional: configurar destino desde la interfaz

