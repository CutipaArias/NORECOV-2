{
  "name": "NORECOV Expo",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": true,
      "dockerDashComposeVersion": "latest"
    }
  },
  "postCreateCommand": "if [ ! -f .env ]; then python3 scripts/generate_env.py; fi",
  "postStartCommand": "bash scripts/codespaces_setup.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "NORECOV Expo",
      "onAutoForward": "openBrowser"
    }
  }
}